{
  "name": "fastboot",
  "version": "6.0.0",
  "description": "Render Ember apps in Node.js, from a classic build, a Vite SSR build, or the Vite dev server",
  "keywords": [
    "ember",
    "fastboot",
    "ssr",
    "vite"
  ],
  "homepage": "https://github.com/ember-fastboot/ember-cli-fastboot#readme",
  "bugs": {
    "url": "https://github.com/ember-fastboot/ember-cli-fastboot/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ember-fastboot/ember-cli-fastboot.git",
    "directory": "packages/fastboot"
  },
  "license": "MIT",
  "author": "Tom Dale and FastBoot contributors",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./middleware": {
      "types": "./src/middleware.d.ts",
      "default": "./src/middleware.js"
    },
    "./prerender": {
      "types": "./src/prerender.d.ts",
      "default": "./src/prerender.js"
    },
    "./vite": {
      "types": "./src/vite.d.ts",
      "default": "./src/vite.js"
    }
  },
  "files": [
    "src"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org"
  },
  "peerDependencies": {
    "vite": "^6.0.0 || ^7.0.0 || ^8.0.0"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "engines": {
    "node": ">= 22.12"
  },
  "dependencies": {
    "@happy-dom/global-registrator": "^21.0.4"
  }
}
