{
  "name": "ember-cli-fastboot",
  "version": "6.0.0",
  "description": "Server-side rendering for Ember apps: the fastboot service and the browser boot",
  "keywords": [
    "ember-addon"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/ember-fastboot/ember-cli-fastboot.git",
    "directory": "packages/ember-cli-fastboot"
  },
  "license": "MIT",
  "author": "Tom Dale & Yehuda Katz <tomhuda@tilde.io>",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./boot": {
      "types": "./src/boot.d.ts",
      "default": "./src/boot.js"
    },
    "./services/fastboot": {
      "types": "./src/services/fastboot.d.ts",
      "default": "./src/services/fastboot.js"
    },
    "./addon-main.cjs": "./addon-main.cjs",
    "./settled": {
      "types": "./src/settled.d.ts",
      "default": "./src/settled.js"
    },
    "./_app_/*": "./src/_app_/*.js"
  },
  "files": [
    "addon-main.cjs",
    "src"
  ],
  "dependencies": {
    "@embroider/addon-shim": "^1.11.0",
    "fastboot": "workspace:*"
  },
  "peerDependencies": {
    "ember-source": ">= 6.4.0"
  },
  "engines": {
    "node": ">= 22.12"
  },
  "ember": {
    "edition": "octane"
  },
  "ember-addon": {
    "version": 2,
    "type": "addon",
    "main": "addon-main.cjs",
    "app-js": {
      "./services/fastboot.js": "./src/_app_/services/fastboot.js"
    },
    "before": [
      "broccoli-serve-files"
    ]
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org"
  }
}
